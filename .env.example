# Copy this file to `.env` and fill in your keys.
# The server reads it at boot; the browser never sees these values.

# --- Claude (design brief, room reading, furniture + budget planning) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional override. Defaults to claude-opus-5.
CLAUDE_MODEL=claude-opus-5

# --- Google Gemini (image-to-image room restyling) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override. Nano Banana Pro is the strongest at keeping your room's
# real geometry while changing the design.
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# --- Server ---
PORT=8787

# With no keys set the server runs in DEMO MODE: the whole flow works and the
# render step returns placeholder images so you can click through the app.
