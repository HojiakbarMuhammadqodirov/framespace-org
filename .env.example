# Copy this file to `.env` and fill in your keys.
# The server reads it at boot; the browser never sees these values.
# On Render, set the same names under the service's Environment tab
# (render.yaml already lists them).

# --- Claude (design brief, room reading, furniture + budget planning) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional override. Defaults to claude-sonnet-5-5 — the cost-sensible choice.
# claude-opus-5-5 writes the strongest briefs but costs several times more per
# render; claude-haiku-4-5-20251001 is the cheapest.
CLAUDE_MODEL=claude-sonnet-5-5
# Upper bound on output tokens (thinking included) for any one Claude call.
# CLAUDE_MAX_OUTPUT_TOKENS=16000
# CLAUDE_TIMEOUT_MS=180000
# CLAUDE_MAX_RETRIES=3

# --- Google Gemini (image-to-image room restyling) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override. Nano Banana Pro is the strongest at keeping your room's
# real geometry while changing the design.
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# Hard cap on images generated per render request (each one is billed).
# GEMINI_MAX_IMAGES_PER_REQUEST=4
# GEMINI_TIMEOUT_MS=120000
# GEMINI_MAX_RETRIES=2

# --- Cost controls ---
# Apply whenever ANTHROPIC_API_KEY or GEMINI_API_KEY is set (renders can cost
# money). Then /api/render and /api/render-scene need a signed-in user (401
# `unauthenticated`), each user gets RENDER_DAILY_QUOTA renders per UTC day
# (429 `quota_exceeded`), and all users together get GLOBAL_DAILY_RENDER_CAP
# per UTC day (503 `capacity`) — the last line of defence for your bill.
# RENDER_DAILY_QUOTA=5
# GLOBAL_DAILY_RENDER_CAP=100
# RENDER_RATE_LIMIT=20          # /api/render* requests per IP per 10 minutes
# Enforce the sign-in/quota/cap rules in demo mode too (to test them for free).
# RENDER_LIMITS_IN_DEMO=false

# --- Database (optional locally, needed on free hosts) ---
# Unset: accounts, sessions, quotas and messages live in JSON files under
# DATA_DIR. Free hosts wipe their disk on every deploy, so in production set a
# Postgres URL — Neon (https://neon.tech) or Supabase (https://supabase.com)
# free tiers work. Tables are created automatically at boot.
# DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# TLS: verify (default; Neon) | no-verify (Supabase, whose certs use its own CA)
#      | disable (a database on localhost only)
# DATABASE_SSL=verify
# DATABASE_SSL_CA=              # PEM text of a CA to trust instead of no-verify
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT_MS=15000

# --- Server ---
PORT=8787
# HOST=0.0.0.0                  # interface to bind (all, so hosts can reach it)
# NODE_ENV=production           # Secure cookies, SPA served from dist/
# DATA_DIR=server/data          # JSON store location when DATABASE_URL is unset
# TRUST_PROXY=1                 # proxies in front: 1 = Render alone,
#                               # 2 = Vercel rewrite -> Render (see render.yaml)
# CORS_ORIGINS=                 # comma-separated; leave empty for same-origin
# RENDER_TIMEOUT_MS=360000      # hard deadline for one render request
# RENDER_BODY_LIMIT=30mb
# CLIENT_ERRORS_KEEP=200        # newest browser error reports kept in storage

# --- Frontend (build time, read by Vite; safe to be public) ---
# VITE_SENTRY_DSN=              # optional; see src/lib/errorReporter.ts
# VITE_RELEASE=                 # optional tag attached to error reports

# With no keys set the server runs in DEMO MODE: the whole flow works and the
# render step returns perspective SVG illustrations of the room (in the style's
# palette) plus a design brief in the user's language (uz / ru / en), so you can
# click through the app — no account needed, nothing billed.
